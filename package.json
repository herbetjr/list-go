{
  "name": "listas-compartilhadas",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestão de listas compartilhadas - Quem leva o quê?",
  "keywords": [
    "quasar",
    "quasar-app",
    "vue",
    "listas",
    "quem-leva-o-que"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,FRONT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:front\"",
    "dev:front": "quasar dev",
    "dev:server": "cd server && npm run dev",
    "build": "npm run build:front && npm run build:server && node scripts/build-dist.js",
    "build:front": "quasar build",
    "build:server": "cd server && npm run build",
    "migration:fresh": "cd server && npm run migration:fresh",
    "migration:run": "cd server && npm run migration:run",
    "migration:revert": "cd server && npm run migration:revert",
    "install:server": "cd server && npm install",
    "install:all": "npm install && cd server && npm install",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "quasar": "^2.35.1",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^22.19.11",
    "@types/qrcode": "^1.5.5",
    "autoprefixer": "^10.4.27",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.8",
    "sass": "^1.85.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 20"
  },
  "productName": "Listas Compartilhadas"
}

